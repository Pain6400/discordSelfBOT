# Token personal de tu cuenta de Discord (Selfbot)
DISCORD_USER_TOKEN=tu_token_de_usuario_aqui

# Tu ID de usuario de Discord (snowflake de 17-19 dígitos)
MI_USER_ID=123456789012345678

# Lista de IDs de servidores (Guilds) a vigilar, separados por comas
WATCHED_GUILDS=111111111111111111,222222222222222222

# El apodo exacto que deseas mantener siempre en esos servidores
DESIRED_NICKNAME=MiApodoDeseado

# Retardo en milisegundos antes de restaurar el apodo (por defecto: 1500)
RESTORE_DELAY_MS=1500
